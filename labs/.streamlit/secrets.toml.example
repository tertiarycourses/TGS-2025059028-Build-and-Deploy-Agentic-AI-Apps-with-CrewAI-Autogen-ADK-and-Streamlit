# Streamlit Cloud Secrets — TEMPLATE
#
# Do NOT put real keys in this file and do NOT commit a filled-in copy.
# In production (Activity 12) you paste this content, with your own keys, into
# Streamlit Community Cloud:  your app -> Settings -> Secrets.
#
# Locally, prefer a .env file in the project root (see app/.env.example).

OPENAI_API_KEY = "sk-your-openai-key-here"
TAVILY_API_KEY = "tvly-your-tavily-key-here"
GEMINI_API_KEY = "your-gemini-key-here"
OPENROUTER_API_KEY = "sk-or-your-openrouter-key-here"
