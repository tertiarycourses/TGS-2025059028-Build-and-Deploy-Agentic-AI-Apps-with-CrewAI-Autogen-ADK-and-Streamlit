# Copy this file to .env in the project root and paste in YOUR OWN keys.
# NEVER commit the real .env — it is git-ignored for exactly this reason.
#
#   cp app/.env.example .env
#
# Where to get each key (all have a free tier sufficient for this course):
#   OPENAI_API_KEY     https://platform.openai.com/api-keys
#   TAVILY_API_KEY     https://app.tavily.com          (web search tool)
#   GEMINI_API_KEY     https://aistudio.google.com/apikey
#   OPENROUTER_API_KEY https://openrouter.ai/keys
#   OPENWEATHER_API_KEY https://openweathermap.org/api (optional, Activity 7)

OPENAI_API_KEY=sk-your-openai-key-here
TAVILY_API_KEY=tvly-your-tavily-key-here
GEMINI_API_KEY=your-gemini-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENWEATHER_API_KEY=your-openweather-key-here
