# ---------------------------------------------------------------- CONFIDENTIAL
# WSQ assessment material (question papers AND answer keys) is trainer-only and
# is distributed via Google Drive / LMS-TMS. It must NEVER be committed.
assessment/
**/assessment/

# ---------------------------------------------------------------- secrets
.env
.env.*
!.env.example
*.key
.streamlit/secrets.toml

# ---------------------------------------------------------------- python
.venv/
venv/
__pycache__/
*.py[cod]
.chroma/
chroma_db/

# ---------------------------------------------------------------- os / office junk
.DS_Store
Thumbs.db
~$*
*.tmp

# ---------------------------------------------------------------- build scratch
courseware/archive/*.tmp
labs/data/audit_log.jsonl

# lab secret files — templates only ship
labs/app/.env
labs/.streamlit/secrets.toml

# Courseware build toolchain and generators — internal, not for the public course repo.
# build_assessment.py carries the assessment model answers, so .claude must never be pushed.
.claude/
reference/

# ---------------------------------------------------------------- distribution archives
# Rebuildable bundles — never pushed to GitHub. Use a Release asset instead.
*.zip

# ---------------------------------------------------------------- derived-from source material
# reference/ holds the original deck this courseware was derived from — third-party
# material that is not ours to republish.
**/reference/
# ...but the wsq-slides skill ships a reference IMPLEMENTATION (builder scripts the
# toolchain actually runs). That is working code, not source material — keep it.
!.claude/skills/**/reference/
!.claude/skills/**/reference/**
